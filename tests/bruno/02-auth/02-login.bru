meta {
  name: Login Test User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

tests {
  test("login returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("login returns access token", function() {
    expect(res.body.token).to.be.a("string").and.not.empty;
  });

  test("login returns refresh token", function() {
    expect(res.body.refresh_token).to.be.a("string").and.not.empty;
  });

  if (res.status === 200 && typeof res.body.token === "string" && res.body.token.length > 0) {
    bru.setEnvVar("token", res.body.token);
  }

  if (res.status === 200 && typeof res.body.refresh_token === "string" && res.body.refresh_token.length > 0) {
    bru.setEnvVar("refreshToken", res.body.refresh_token);
  }
}
