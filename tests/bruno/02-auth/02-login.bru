meta {
  name: Login Test User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

tests {
  test("login returns 200", function() { expect(res.status).to.equal(200); });
  test("login returns access token", function() { expect(res.body.token).to.be.a("string").and.not.empty; bru.setVar("token", res.body.token); });
  test("login returns refresh token", function() { expect(res.body.refresh_token).to.be.a("string").and.not.empty; bru.setVar("refreshToken", res.body.refresh_token); });
}
