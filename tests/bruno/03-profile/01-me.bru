meta {
  name: Get Current User
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("profile returns 200", function() { expect(res.status).to.equal(200); });
  test("profile is the test user", function() { expect(res.body.email).to.equal(bru.getEnvVar("testEmail")); });
}
