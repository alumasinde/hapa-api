meta {
  name: Create Flash
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/flashes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "category": "traffic",
    "source": "user",
    "description": "Automated Bruno test flash",
    "lat": -1.286389,
    "lng": 36.817223,
    "area_name": "Nairobi CBD"
  }
}

tests {
  const body = typeof res.body === "string" ? JSON.parse(res.body) : res.body;

  test("flash is created", function() {
    expect(res.status).to.equal(201);
    expect(body.id).to.exist;
  });

  if (res.status === 201 && body?.id !== undefined && body?.id !== null) {
    bru.setEnvVar("flashId", String(body.id));
  }
}
