meta {
  name: Get Nearby Flashes
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/flashes?lat=-1.286389&lng=36.817223&radius=5&category=traffic
  body: none
  auth: none
}

tests {
  test("nearby feed returns 200", function() { expect(res.status).to.equal(200); });
  test("nearby feed returns flashes", function() { expect(res.body.flashes).to.be.an("array"); });
  test("created flash appears in nearby feed", function() { const id = Number(bru.getVar("flashId")); expect(res.body.flashes.some(function(flash) { return Number(flash.id) === id; })).to.equal(true); });
}
