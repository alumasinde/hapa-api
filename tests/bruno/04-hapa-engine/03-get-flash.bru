meta {
  name: Get Flash
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/flashes/{{flashId}}
  body: none
  auth: none
}

tests {
  const body = typeof res.body === "string" ? JSON.parse(res.body) : res.body;

  test("flash detail returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("flash id matches", function() {
    expect(Number(body.id)).to.equal(Number(bru.getEnvVar("flashId")));
  });
}
