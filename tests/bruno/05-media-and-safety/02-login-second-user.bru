meta {
  name: Login Second Test User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "hapa.reporter@example.com",
    "password": "{{testPassword}}"
  }
}

tests {
  const body = typeof res.body === "string" ? JSON.parse(res.body) : res.body;

  test("second login returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("second login returns access token", function() {
    expect(body).to.have.property("token");
    expect(body.token).to.be.a("string").and.not.empty;
  });

  test("second login returns refresh token", function() {
    expect(body).to.have.property("refresh_token");
    expect(body.refresh_token).to.be.a("string").and.not.empty;
  });

  if (res.status === 200 && typeof body?.token === "string" && body.token.length > 0) {
    bru.setEnvVar("reporterToken", body.token);
  }

  if (res.status === 200 && typeof body?.refresh_token === "string" && body.refresh_token.length > 0) {
    bru.setEnvVar("reporterRefreshToken", body.refresh_token);
  }
}
