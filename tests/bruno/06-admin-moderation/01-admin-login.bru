meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/auth/login
  body: json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  test("admin login succeeds", function() { expect(res.status).to.equal(200); expect(res.body.token).to.be.a("string"); bru.setEnvVar("adminToken", res.body.token); });
}
