meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  let body = res.body;

  if (typeof body === "string") {
    const first = body.indexOf("{");
    const last = body.lastIndexOf("}");

    if (first >= 0 && last >= first) {
      body = JSON.parse(body.slice(first, last + 1));
    }
  }

  test("admin login succeeds", function() {
    expect(res.status).to.equal(200);
  });

  test("admin login returns token", function() {
    expect(body).to.be.an("object");
    expect(body.token).to.be.a("string").and.not.empty;
  });

  if (
    res.status === 200 &&
    body &&
    typeof body.token === "string" &&
    body.token.length > 0
  ) {
    bru.setEnvVar("adminToken", body.token);
  }

  if (
    res.status === 200 &&
    body &&
    body.session_id !== undefined &&
    body.session_id !== null
  ) {
    bru.setEnvVar("adminSessionId", String(body.session_id));
  }
}
