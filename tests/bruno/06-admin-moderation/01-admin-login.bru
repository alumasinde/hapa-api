meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  const body = typeof res.body === "string" ? JSON.parse(res.body) : res.body;

  test("admin login succeeds", function() {
    expect(res.status).to.equal(200);
  });

  test("admin login returns token", function() {
    expect(body).to.have.property("token");
    expect(body.token).to.be.a("string").and.not.empty;
  });

  if (res.status === 200 && typeof body?.token === "string" && body.token.length > 0) {
    bru.setEnvVar("adminToken", body.token);
  }

  if (res.status === 200 && body?.session_id !== undefined && body?.session_id !== null) {
    bru.setEnvVar("adminSessionId", String(body.session_id));
  }
}
