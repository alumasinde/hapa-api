meta {
  name: List Reported Flashes
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/flashes/reported
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("reported flashes are listed", function() { expect(res.status).to.equal(200); expect(res.body.flashes).to.be.an("array"); });
}
