meta {
  name: Hide Flash
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/flashes/{{flashId}}/hide
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "reason": "Confirmed harmful or misleading content"
  }
}

tests {
  test("flash is hidden", function() { expect(res.status).to.equal(200); expect(res.body.moderation_status).to.equal("hidden"); });
}
