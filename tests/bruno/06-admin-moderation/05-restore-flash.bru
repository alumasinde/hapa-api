meta {
  name: Restore Flash
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/flashes/{{flashId}}/restore
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "reason": "Moderation review completed"
  }
}

tests {
  test("flash is restored", function() { expect(res.status).to.equal(200); expect(res.body.moderation_status).to.equal("visible"); });
}
