meta {
  name: Change User Status
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/admin/users/{{targetUserId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "active"
  }
}

tests {
  test("user status is active", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("active");
  });
}
