meta {
  name: Mark Flash Helpful
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/flashes/{{flashId}}/helpful
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  const body = typeof res.body === "string" ? JSON.parse(res.body) : res.body;

  test("helpful reaction is recorded", function() {
    expect(res.status).to.equal(200);
    expect(body.engagement.marked_helpful).to.equal(true);
    expect(body.engagement.helpful).to.be.at.least(1);
  });
}
